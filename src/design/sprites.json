  "road": {
    "laneHeight": {
      "car": 24,
      "truck": 32
    },
    "vehicle": {
      "clearTop": 2,
      "bottomInset": 2
    },
    "note": "A vehicle fills its lane. There is deliberately no empty corridor above a car, because a corridor reads as passable space and it is not. Ownership is carried by the flat shadow inside the band."
  },
  "spawn": {
    "fixed": false,
    "note": "NOTHING ON THE ROAD IS FIXED. Bus stop position, which loot is on the bench, which lane the truck owns, traffic gaps and phases are all rolled per run. The player walks to the loot and crosses for it; a bot that learns one layout learns nothing.",
    "perRun": {
      "busStops": "1-2 per run, x rolled along the top pavement, never within 24px of an edge",
      "loot": "wallet | painting | both | none — rolled per bus stop",
      "lootPosition": "on the bench of its own stop, so reaching it costs crossings",
      "truckLane": "one lane is promoted to a 32px truck lane, rolled per run",
      "trafficPhase": "per-lane offset and gap rolled per run, never a repeating pattern",
      "obstacles": "tree | bin | bollard positions rolled on the verge and pavements"
    }
  }
