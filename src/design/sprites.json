    "w": 22,
    "h": 32,
    "footRow": 8,
    "xOffset": 1,
    "note": "Feet sit on the cell bottom row at every scale. Integer scales only."
  },
  "composite": {
    "strategy": "runtime-stacking",
    "note": "There are no accessories. The only thing that changes on the figure is what is in his two fists, drawn as a held layer over the pose and NOT masked to it — the item sticks out past his silhouette.",
    "order": [
      "thief.<pose>",
      "held.<left>",
      "held.<right>"
    ],
    "hands": {
      "ticket": [
        "held.ticket"
      ],
      "wallet": [
        "held.wallet"
      ],
      "painting": [
        "held.painting"
      ],
      "both": [
        "held.wallet",
        "held.painting"
      ],
      "empty": [],
      "note": "ticket is the default carry. He can lift the wallet alone, the painting alone, or both; the ticket is out of sight while he is holding anything stolen, and comes back when the loot is cashed. Wallet is always the left fist, painting always the right."
    },
    "fists": {
      "left": {
        "x": 3,
        "y": 12
      },
      "right": {
        "x": 16,
        "y": 12
      }
    }
  },
