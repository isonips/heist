# Copy to .env.local for local dev, and set the same two values in the
# Vercel project's Environment Variables for production/preview — see
# DECISIONS.md P1 for the schema these point at and README.md for how the
# app degrades (gracefully, to local-only storage) when they're unset.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional — connectPrivy() in src/game/identity.ts is a documented stub
# until this is set. See DECISIONS.md #4.
# NEXT_PUBLIC_PRIVY_APP_ID=
