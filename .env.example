# Copy to .env.local for local dev, and set the same values in the Vercel
# project's Environment Variables for production/preview — see
# DECISIONS.md P1/P2 for the schema/auth these point at and README.md for
# how the app degrades (gracefully, to local-only storage / DEMO-only) when
# they're unset.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required for PLAY/PROFILE (login, username claim, server-authoritative
# writes). Without these the app still builds and DEMO still works, but
# CONNECT and everything gated on an address is unavailable — see
# DECISIONS.md P2.
NEXT_PUBLIC_PRIVY_APP_ID=
# Privy dashboard -> App settings -> Basics. NOT the same as the app ID —
# this one is server-only, never exposed to the client.
PRIVY_APP_SECRET=

# Signs the app's own session cookie (see src/lib/session.ts). Any long
# random string; must be identical across all instances that need to read
# each other's sessions (i.e. the same value in every Vercel environment
# that shares users). Generate with e.g. `openssl rand -hex 32`.
SESSION_SECRET=

# Supabase dashboard -> Project settings -> API -> service_role key.
# Server-only, bypasses RLS — see src/lib/supabaseAdmin.ts. This is what
# lets the server write profiles/stats/tickets authoritatively instead of
# through the client's anon key.
SUPABASE_SERVICE_ROLE_KEY=
